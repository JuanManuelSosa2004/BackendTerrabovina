PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=terrabovina_db
DB_NAME_TEST=terrabovina_db_test
DB_USER=terrabovina_user
DB_PASSWORD=terrabovina_pass


DB_ROOT_USER=root
DB_ROOT_PASSWORD=root_pass

# RNF005: token de sesión firmado con vencimiento definido.
JWT_SECRET=changeme
JWT_EXPIRES_IN=2h

# RNF006: token de recuperación de contraseña, de un solo uso y con plazo acotado.
PASSWORD_RESET_TOKEN_EXPIRES_MIN=30

# Envío del correo de recuperación (Gmail SMTP vía nodemailer). SMTP_USER es
# la cuenta de Gmail remitente; SMTP_PASS es una "contraseña de aplicación"
# generada en https://myaccount.google.com/apppasswords (requiere 2FA
# activado en esa cuenta), no la contraseña normal de la cuenta.
SMTP_USER=tu-cuenta@gmail.com
SMTP_PASS=contraseña-de-aplicacion-de-16-caracteres
MAIL_FROM=TerraBovina <tu-cuenta@gmail.com>

# Opcional: si hay un frontend, el mail arma un link a esta URL + el token.
# Sin esto, el mail incluye el token a secas.
FRONTEND_URL=
